{
	"schemaVersion": 1,
	"id": "steamed",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_authors}"
	],
	"contact": {
		"sources": "${mod_sources_url}",
		"email": "${mod_contact_email}",
		"issues": "${mod_issues_url}"
	},
	"license": "${mod_license}",
	"icon": "assets/steamed/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			{
				"value": "xyz.kkaii.steamed.fabric.SteamedFabric",
				"adapter": "kotlin"
			}
		],
		"preLaunch": [
			{
				"value": "xyz.kkaii.steamed.fabric.SteamPreLaunchFabric",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "xyz.kkaii.steamed.fabric.SteamedFabric",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"steamed.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-language-kotlin": ">=1.13.14"
	}
}